{
  "name": "textpen",
  "version": "0.1.0",
  "description": "A code editor in the terminal pane: a file tree, tabs, search and the terminal's own colours, over plain ssh",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "editor",
    "terminal",
    "mcp",
    "mcp-apps",
    "pencere",
    "codemirror",
    "ssh"
  ],
  "type": "module",
  "bin": {
    "textpen": "./dist/server/main.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:view && npm run build:server",
    "build:view": "vite build && vite build --mode single",
    "build:server": "tsc -p tsconfig.server.json",
    "harness": "npm run build:server && vite --mode harness",
    "start": "node dist/server/main.js",
    "dev": "node dist/server/main.js --dev",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "npm run build && node --test 'test/*.test.ts'",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "@pencere/sdk": "^0.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/client": "^2.3.1",
    "@replit/codemirror-vim": "^6.4.0",
    "@tabler/icons-react": "^3.49.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "zustand": "^5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bateri/textpen.git"
  },
  "homepage": "https://github.com/bateri/textpen#readme",
  "bugs": {
    "url": "https://github.com/bateri/textpen/issues"
  }
}
