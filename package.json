{
  "name": "textpen",
  "private": true,
  "description": "A code editor in the terminal pane: a file tree, tabs, search and the terminal's own colours, over plain ssh. This manifest builds the editor (src/view) and runs the tests; textpen itself is one native file with no Node in it.",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "editor",
    "terminal",
    "pencere",
    "codemirror",
    "ssh"
  ],
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/page.test.ts test/batches.test.ts test/fuzzy.test.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "@tabler/icons-react": "^3.49.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "marked": "^18.1.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "zustand": "^5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bateri/textpen.git"
  },
  "homepage": "https://github.com/bateri/textpen#readme",
  "bugs": {
    "url": "https://github.com/bateri/textpen/issues"
  }
}
